DEV_GROUP_ID=2001
LOCAL_DEV_GROUP_NAME=usctdp_devs

WORDPRESS_DB=wordpress_test
WORDPRESS_DB_USER=wordpress_test
DB_WORDPRESS_PASSWORD_FILE=PATH_TO_DB_PASSWORD_FILE
DB_ROOT_PASSWORD_FILE=PATH_TO_DB_ROOT_PASSWORD_FILE

PROJECTS_DIR=PATH_TO_PROJECTS_DIR
PROJECT=usctdp-bedrock
THEME=usctdp-theme

# Same dev stack's WEB_HOSTNAME (127.0.0.1) is fine to reuse here - nginx's
# server_name match ignores the port, and the actual host<->container
# routing collision that matters is on LOCAL_PORT_HTTP/HTTPS below, which
# are distinct from dev's (80/443) so both stacks can run at once. See
# gen_bedrock_config.py's WEB_PORT_PUBLIC handling for how WP_HOME accounts
# for the non-default port.
USE_HTTPS=0
WEB_HOSTNAME=127.0.0.1
WP_SITE_TITLE="USCTDP (test)"
WP_ADMIN_USER="admin"
WP_ADMIN_PASSWORD_FILE=PATH_TO_ADMIN_PASSWORD_FILE
WP_ADMIN_EMAIL="admin@example.com"
WEB_PORT_HTTP=8080
PROXY_PORT_HTTP=80
PROXY_PORT_HTTPS=443
LOCAL_PORT_HTTP=8180
LOCAL_PORT_HTTPS=8543
WEB_PROTOCOL=http
CERTS_PATH=./usused_certs

# Deliberately "development" (not "testing") - there's no
# config/environments/testing.php in the bedrock project, so any other value
# would silently skip the WP_DEBUG/SAVEQUERIES/etc. overrides that
# development.php provides and this stack wants the same behavior dev gets.
WP_ENV="development"
WP_DEBUG=true
WP_DEBUG_DISPLAY=true

# Mailpit catches all outgoing mail instead of delivering it - view messages
# at http://localhost:${MAILPIT_WEB_PORT}. No auth/TLS needed for its SMTP
# listener, which is why WORDPRESS_SMTP_USER/PASS aren't set here. Distinct
# from dev's 8025 so both stacks' mailpit UIs can run at once.
MAILPIT_WEB_PORT=8125
WORDPRESS_SMTP_HOST=mailpit
WORDPRESS_SMTP_PORT=1025
WORDPRESS_SMTP_ENCRYPTION=none

# Skip WooCommerce's "set your password by email" registration flow so E2E
# tests can create/log into accounts without a Mailpit round trip. Only
# takes effect when WP_ENV is exactly "development" (enforced in code).
DEV_SKIP_REGISTRATION_LOGOUT=1
