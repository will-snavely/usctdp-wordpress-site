DEV_GROUP_ID=2001
LOCAL_DEV_GROUP_NAME=usctdp_devs

WORDPRESS_DB=wordpress_dev
WORDPRESS_DB_USER=wordpress_dev
DB_WORDPRESS_PASSWORD_FILE=PATH_TO_DB_PASSWORD_FILE
DB_ROOT_PASSWORD_FILE=PATH_TO_DB_ROOT_PASSWORD_FILE

PROJECTS_DIR=PATH_TO_PROJECTS_DIR
PROJECT=usctdp-bedrock
THEME=usctdp-theme

USE_HTTPS=0
WEB_HOSTNAME=127.0.0.1
WP_SITE_TITLE="USCTDP"
WP_ADMIN_USER="admin"
WP_ADMIN_PASSWORD_FILE=PATH_TO_ADMIN_PASSWORD_FILE
WP_ADMIN_EMAIL="admin@example.com"
WEB_PORT_HTTP=8080
PROXY_PORT_HTTP=80
PROXY_PORT_HTTPS=443
LOCAL_PORT_HTTP=80
LOCAL_PORT_HTTPS=443
WEB_PROTOCOL=http
CERTS_PATH=./usused_certs
WP_ENV="development"
WP_DEBUG=true
WP_DEBUG_DISPLAY=true

# Mailpit catches all outgoing mail instead of delivering it - view messages
# at http://localhost:${MAILPIT_WEB_PORT}. No auth/TLS needed for its SMTP
# listener, which is why WORDPRESS_SMTP_USER/PASS aren't set here.
MAILPIT_WEB_PORT=8025
WORDPRESS_SMTP_HOST=mailpit
WORDPRESS_SMTP_PORT=1025
WORDPRESS_SMTP_ENCRYPTION=none

# When 1, new WooCommerce registrations skip the "set your password by
# email" flow and auto-login like WooCommerce does by default - handy for
# quickly creating test accounts without a Mailpit round trip. Only takes
# effect when WP_ENV is exactly "development" (enforced in code, not just
# by convention here).
DEV_SKIP_REGISTRATION_LOGOUT=0
