WORDPRESS_DB=wordpress_prod
WORDPRESS_DB_USER=wordpress_prod
DB_WORDPRESS_PASSWORD_FILE=PATH_TO_DB_PASSWORD_FILE
DB_ROOT_PASSWORD_FILE=PATH_TO_DB_ROOT_PASSWORD_FILE
PROJECT=usctdp-bedrock
THEME=usctdp-theme
USE_HTTPS=0
WEB_HOSTNAME=127.0.0.1
WP_SITE_TITLE="USCTDP"
WP_ADMIN_USER="usctdp_adm"
WP_ADMIN_PASSWORD_FILE=PATH_TO_ADMIN_PASSWORD_FILE
WP_ADMIN_EMAIL="admin@example.com"
WEB_PORT_HTTP=80
PROXY_PORT_HTTP=80
PROXY_PORT_HTTPS=443
LOCAL_PORT_HTTP=80
LOCAL_PORT_HTTPS=443
WEB_PROTOCOL=http
WP_ENV="production"
WP_DEBUG=false
WP_DEBUG_DISPLAY=false

# Tag of the horsecatdog/${PROJECT} image to deploy. CI pushes both `latest`
# and the git commit SHA on every push to main - pin this to a specific SHA
# for a reproducible/rollback-able deploy, or leave as `latest` to always
# pull the newest build.
WEB_IMAGE_TAG=latest

# Without these, wp-mail-smtp stays unconfigured and outgoing mail (account
# creation, password resets, order emails) silently goes nowhere - there's
# no local MTA in the container for PHP's mail() fallback to use. The Docker
# secret plumbing in compose.prod.yaml (smtp_password_prod) is already wired
# up - once an SMTP provider is chosen (SES, SendGrid, Mailgun, Postmark,
# etc. - any provider exposing a standard SMTP endpoint works), just
# uncomment these and point SMTP_PASSWORD_FILE at the real password file.
# WORDPRESS_SMTP_HOST=
# WORDPRESS_SMTP_PORT=587
# WORDPRESS_SMTP_ENCRYPTION=tls
# WORDPRESS_SMTP_USER=
# WORDPRESS_SMTP_FROM_EMAIL=
# WORDPRESS_SMTP_FROM_NAME=
# SMTP_PASSWORD_FILE=PATH_TO_SMTP_PASSWORD_FILE

# S3-compatible destination used by both the DB dump backup (the `backup`
# service) and the uploads volume backup (`uploads-backup`) - same
# credentials, same endpoint/region, just different buckets/paths.
# BACKUP_S3_TARGET is databack/mysql-backup's own target URI format;
# BACKUP_S3_BUCKET_NAME is the same bucket for docker-volume-backup, which
# wants the bucket name and path (AWS_S3_PATH, set in compose.prod.yaml)
# passed separately rather than as one URI.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_TARGET=
BACKUP_S3_BUCKET_NAME=
BACKUP_S3_KEY_FILE=PATH_TO_BACKUP_S3_KEY_FILE
BACKUP_S3_SECRET_FILE=PATH_TO_BACKUP_S3_SECRET_FILE
